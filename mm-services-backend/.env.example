# Copy to .env on the server and fill in. Never commit the real .env.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Nginx sits in front of the app, so trust one proxy hop for client IPs.
TRUST_PROXY=1

# Admin dashboard at https://mmsvcs.com/admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Where new quote requests and applications are emailed.
NOTIFY_EMAIL=info@mmsvcs.com

# Outgoing mail (SMTP) settings from whoever hosts info@mmsvcs.com.
#   Hostinger email:   smtp.hostinger.com, port 465
#   Google Workspace:  smtp.gmail.com, port 465 (use an app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@mmsvcs.com
SMTP_PASS=
SMTP_FROM=MM Services Website <info@mmsvcs.com>

# Defaults, only change if you move things:
# SITE_DIR=../mm-services-website
# DATA_DIR=./data
